# SQL Server JDBC URL. 실제 서버 정보로 변경하십시오.
db.url=jdbc:sqlserver://SERVER_NAME:1433;databaseName=DATABASE_NAME;encrypt=true;trustServerCertificate=true
# 데이터베이스 계정 정보. 실제 application.properties에만 입력하십시오.
db.username=DATABASE_USERNAME
db.password=DATABASE_PASSWORD

# 호출할 저장 프로시저 이름. 실제 이름으로 변경하십시오.
stored-procedure.name=STORED_PROCEDURE_NAME
# 저장 프로시저 입력값은 향후 전용 배치 구현에서 추가할 수 있습니다.

# Windows 공유 폴더를 포함한 Excel 저장 경로입니다.
output.directory=C:/erp-excel-output
# {timestamp}는 실행 시 yyyyMMdd_HHmmss 형식으로 치환됩니다.
output.file-name-pattern=erp_report_{timestamp}.xlsx

