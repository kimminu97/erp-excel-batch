# 저장 프로시저 입력값은 향후 전용 배치 구현에서 추가할 수 있습니다.

# Windows 공유 폴더를 포함한 Excel 저장 경로입니다.
output.directory=C:/erp-excel-output
# {timestamp}는 실행 시 yyMMdd 형식으로 치환됩니다.
excel.output-file-name-pattern=GALA_일자별판매실적분석_3PP_{timestamp}_{period}.xlsx
